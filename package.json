{
  "name": "dsh-automemory",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "description": "Project-scoped automatic memory and a shared user profile for DeepSeek Harness",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SPEC.md",
    "HOST-API.md",
    "UI-API.md",
    "docs/usage.md",
    "docs/privacy.md",
    "docs/compatibility.md",
    "docs/evaluation.md",
    "schemas",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/CI.md",
    "docs/ci-example.yml",
    "docs/RELEASE-NOTES-v0.3.7.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify:public": "node scripts/check-public.mjs",
    "verify:package": "node scripts/check-package.mjs",
    "verify:licenses": "node scripts/check-licenses.mjs",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dsh-context-lite": "https://codeload.github.com/hope586/dsh-context-lite/tar.gz/664de395479f2ec43b2591abb0dcb699d6a92b02",
    "esbuild": "0.25.12"
  },
  "packageManager": "pnpm@10.33.0",
  "author": "hope586",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hope586/dsh-automemory.git"
  },
  "homepage": "https://github.com/hope586/dsh-automemory#readme",
  "bugs": {
    "url": "https://github.com/hope586/dsh-automemory/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "automemory",
    "agent"
  ]
}
