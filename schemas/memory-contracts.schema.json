    "MemoryNotice": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "updated",
            "archived",
            "retracted",
            "deleted",
            "replaced",
            "needs_resolution"
          ]
        },
        "memory_id": {
          "type": "string",
          "minLength": 1
        },
        "from_version": {
          "type": "string",
          "minLength": 1
        },
        "to_version": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "content_markdown": {
          "type": "string",
          "minLength": 1
        },
        "replacement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "issue_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "memory_id",
        "message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "updated"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "from_version",
              "to_version",
              "content_markdown"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "replaced"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "replacement_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "needs_resolution"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "issue_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "updated"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "content_markdown"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "archived",
                  "retracted",
                  "replaced"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "to_version"
            ]
          }
        }
      ]
    },
