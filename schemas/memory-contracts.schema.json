{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-memory:contracts:r2",
  "title": "DSH Memory r2 declarative exchange contracts",
  "description": "Environment-independent declarations. Default root is DraftResult; other contracts are available under $defs. Structure validation is not authorization or runtime verification.",
  "$ref": "#/$defs/DraftResult",
  "$defs": {
    "SourceRef": {
      "type": "object",
      "properties": {
        "source_kind": {
          "enum": [
            "session_event",
            "project_file",
            "memory_record",
            "audit_artifact"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "version_hint": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "source_kind",
        "locator"
      ],
      "additionalProperties": false
    },
    "MarkdownPayload": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "markdown"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "TaskPayload": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "progress": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "goal"
      ],
      "additionalProperties": false
    },
    "MemoryContent": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "stable",
            "active"
          ]
        },
        "index_hint": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "string"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/MarkdownPayload"
            },
            {
              "$ref": "#/$defs/TaskPayload"
            }
          ]
        },
        "format_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "category",
        "index_hint",
        "group",
        "conditions",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "stable"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/MarkdownPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "active"
              },
              "payload": {
                "properties": {
                  "kind": {
                    "const": "markdown"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "category",
              "payload"
            ]
          },
          "then": {
            "required": [
              "format_reason"
            ]
          }
        }
      ]
    },
    "MemoryRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "current",
            "archived",
            "retracted"
          ]
        },
        "content": {
          "$ref": "#/$defs/MemoryContent"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "description": "Retained provenance accumulated across revisions, minus explicit removals. Historical references are not necessarily reverified now or proof of every current statement."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status_reason": {
          "type": "string",
          "minLength": 1
        },
        "replacement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "change_source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 256,
          "description": "Evidence for the latest actual change. Empty for legacy records whose change basis was not separately recorded."
        }
      },
      "required": [
        "id",
        "workspace_id",
        "version",
        "status",
        "content",
        "source_refs",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "archived",
                  "retracted"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "status_reason"
            ]
          }
        }
      ]
    },
    "CreateOperation": {
      "type": "object",
      "properties": {
        "op": {
          "const": "CREATE"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 256,
          "description": "Evidence for this change. The host retains existing record provenance by default; do not copy metadata/Sources blocks into content."
        },
        "local_key": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/MemoryContent"
        }
      },
      "required": [
        "op",
        "operation_key",
        "reason",
        "source_refs",
        "local_key",
        "content"
      ],
      "additionalProperties": false
    },
    "UpdateOperation": {
      "type": "object",
      "properties": {
        "op": {
          "const": "UPDATE"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 256,
          "description": "Evidence for this change. The host retains existing record provenance by default; do not copy metadata/Sources blocks into content."
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/MemoryContent"
        },
        "remove_source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRemoval"
          },
          "maxItems": 256,
          "description": "Optional explicit removals of existing provenance, guarded by expected_version. Omission retains old references."
        }
      },
      "required": [
        "op",
        "operation_key",
        "reason",
        "source_refs",
        "target_id",
        "expected_version",
        "content"
      ],
      "additionalProperties": false
    },
    "RestoreOperation": {
      "type": "object",
      "properties": {
        "op": {
          "const": "RESTORE"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 256,
          "description": "Evidence for this change. The host retains existing record provenance by default; do not copy metadata/Sources blocks into content."
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/MemoryContent"
        },
        "remove_source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRemoval"
          },
          "maxItems": 256,
          "description": "Optional explicit removals of existing provenance, guarded by expected_version. Omission retains old references."
        }
      },
      "required": [
        "op",
        "operation_key",
        "reason",
        "source_refs",
        "target_id",
        "expected_version",
        "content"
      ],
      "additionalProperties": false
    },
    "ArchiveOperation": {
      "type": "object",
      "properties": {
        "op": {
          "const": "ARCHIVE"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 256,
          "description": "Evidence for this change. The host retains existing record provenance by default; do not copy metadata/Sources blocks into content."
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        },
        "replacement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "remove_source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRemoval"
          },
          "maxItems": 256,
          "description": "Optional explicit removals of existing provenance, guarded by expected_version. Omission retains old references."
        }
      },
      "required": [
        "op",
        "operation_key",
        "reason",
        "source_refs",
        "target_id",
        "expected_version"
      ],
      "additionalProperties": false
    },
    "RetractOperation": {
      "type": "object",
      "properties": {
        "op": {
          "const": "RETRACT"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 256,
          "description": "Evidence for this change. The host retains existing record provenance by default; do not copy metadata/Sources blocks into content."
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        },
        "replacement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "remove_source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRemoval"
          },
          "maxItems": 256,
          "description": "Optional explicit removals of existing provenance, guarded by expected_version. Omission retains old references."
        }
      },
      "required": [
        "op",
        "operation_key",
        "reason",
        "source_refs",
        "target_id",
        "expected_version"
      ],
      "additionalProperties": false
    },
    "DeleteOperation": {
      "type": "object",
      "properties": {
        "op": {
          "const": "DELETE"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 256,
          "description": "Evidence for this change. The host retains existing record provenance by default; do not copy metadata/Sources blocks into content."
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op",
        "operation_key",
        "reason",
        "source_refs",
        "target_id",
        "expected_version"
      ],
      "additionalProperties": false
    },
    "MemoryOperation": {
      "oneOf": [
        {
          "$ref": "#/$defs/CreateOperation"
        },
        {
          "$ref": "#/$defs/UpdateOperation"
        },
        {
          "$ref": "#/$defs/ArchiveOperation"
        },
        {
          "$ref": "#/$defs/RetractOperation"
        },
        {
          "$ref": "#/$defs/RestoreOperation"
        },
        {
          "$ref": "#/$defs/DeleteOperation"
        }
      ]
    },
    "ObservedMemory": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_version": {
          "type": "string",
          "minLength": 1,
          "description": "The actual version read BEFORE this atomic DraftResult. The host validates it before operations and links the Issue to the resulting committed version."
        }
      },
      "required": [
        "memory_id",
        "observed_version"
      ],
      "additionalProperties": false
    },
    "IssueProposal": {
      "type": "object",
      "properties": {
        "issue_key": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "affected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObservedMemory"
          },
          "minItems": 0
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "issue_key",
        "question",
        "context",
        "affected",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "ReviewResponse": {
      "type": "object",
      "properties": {
        "finding_index": {
          "type": "integer",
          "minimum": 0
        },
        "disposition": {
          "enum": [
            "adopted",
            "modified",
            "not_adopted"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "finding_index",
        "disposition",
        "explanation"
      ],
      "additionalProperties": false
    },
    "DraftResult": {
      "type": "object",
      "properties": {
        "audit_completion": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryOperation"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IssueProposal"
          },
          "minItems": 0
        },
        "review_responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewResponse"
          },
          "minItems": 0
        }
      },
      "required": [
        "audit_completion",
        "explanation",
        "operations",
        "issues"
      ],
      "additionalProperties": false
    },
    "TrustedExecutionContext": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "enum": [
            "main_agent",
            "g2_worker",
            "dreamer",
            "memory_ui",
            "system"
          ]
        },
        "channel": {
          "enum": [
            "G1",
            "G2",
            "DREAMING",
            "MEMORY_UI"
          ]
        },
        "initiated_by": {
          "enum": [
            "model",
            "user"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "user_intent_ref": {
          "type": "string",
          "minLength": 1
        },
        "delete_authorization_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "workspace_id",
        "actor",
        "channel",
        "initiated_by"
      ],
      "additionalProperties": false
    },
    "ChangeSet": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/TrustedExecutionContext"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryOperation"
          },
          "minItems": 1
        },
        "audit_artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "request_id",
        "context",
        "operations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "context": {
                "properties": {
                  "channel": {
                    "enum": [
                      "G2",
                      "DREAMING"
                    ]
                  }
                },
                "required": [
                  "channel"
                ]
              }
            },
            "required": [
              "context"
            ]
          },
          "then": {
            "properties": {
              "operations": {
                "items": {
                  "not": {
                    "properties": {
                      "op": {
                        "const": "DELETE"
                      }
                    },
                    "required": [
                      "op"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ErrorInfo": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_PROPOSAL",
            "PERMISSION_DENIED",
            "DELETE_NOT_AUTHORIZED",
            "VERSION_CONFLICT",
            "NOT_FOUND",
            "NONCURRENT",
            "IDEMPOTENCY_CONFLICT",
            "SOURCE_UNAVAILABLE",
            "TASK_NOT_ACCEPTED",
            "PROJECTION_UNAVAILABLE",
            "INDEX_CAPACITY",
            "REVIEW_UNAVAILABLE",
            "CLEANUP_INCOMPLETE",
            "INTERNAL_FAILURE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "operation_key": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "OperationResult": {
      "type": "object",
      "properties": {
        "operation_key": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "CREATE",
            "UPDATE",
            "ARCHIVE",
            "RETRACT",
            "RESTORE",
            "DELETE"
          ]
        },
        "memory_id": {
          "type": "string",
          "minLength": 1
        },
        "before_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "after_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "applied",
            "unchanged",
            "not_applied"
          ]
        },
        "replacement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "operation_key",
        "operation",
        "memory_id",
        "before_version",
        "after_version",
        "outcome"
      ],
      "additionalProperties": false
    },
    "CommitReceipt": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "accepted",
            "committed",
            "no_change",
            "rejected",
            "failed"
          ]
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_revision": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationResult"
          },
          "minItems": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErrorInfo"
          },
          "minItems": 0
        },
        "cleanup_status": {
          "enum": [
            "not_applicable",
            "pending",
            "complete",
            "incomplete"
          ]
        },
        "scope_statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "request_id",
        "status",
        "workspace_id",
        "results",
        "errors"
      ],
      "additionalProperties": false
    },
    "G2Request": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "AuditWindow": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "start_exclusive": {
          "type": "string",
          "minLength": 1
        },
        "end_inclusive": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session_id",
        "start_exclusive",
        "end_inclusive"
      ],
      "additionalProperties": false
    },
    "JobReceipt": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
